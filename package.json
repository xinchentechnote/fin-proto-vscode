{
  "name": "fin-proto-vscode",
  "displayName": "FinProto - PacketDSL Support",
  "description": "financial binary proto dsl plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/xinchentechnote/fin-proto-vscode.git"
  },
  "publisher": "xinchentechnote",
  "icon": "icon.png",
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "packetdsl",
    "protocol",
    "fin-protoc",
    "binary protocol"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fin-proto-vscode.format",
        "title": "fin-proto:format"
      },
      {
        "command": "fin-proto-vscode.compile",
        "title": "fin-proto:compile"
      }
    ],
    "configuration": {
      "title": "fin-proto",
      "properties": {
        "finProto.protocPath": {
          "type": "string",
          "default": "fin-protoc",
          "description": "fin-protoc 编译器可执行文件路径（默认从 PATH 查找）"
        },
        "finProto.outputDir": {
          "type": "string",
          "description": "编译产物输出目录，默认为 DSL 文件同级的 gen 目录"
        }
      }
    },
    "grammars": [
      {
        "language": "packetdsl",
        "scopeName": "source.packetdsl",
        "path": "./syntaxes/packetdsl.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "packetdsl",
        "aliases": [
          "PacketDSL",
          "packetdsl"
        ],
        "extensions": [
          ".pdsl",
          ".dsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "packetdsl",
        "path": "./snippets/packetdsl.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "gen": "cp submodules/fin-protoc/grammar/PacketDsl.g4 PacketDsl.g4 && npx antlr4ts -o src/parser/antlr4 -visitor PacketDsl.g4 && rm PacketDsl.g4",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "vsce package",
    "compile-tests": "tsc -p . --outDir out && tsc -p src/test",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test-integration": "npm run compile-tests && node esbuild.js && vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "antlr4ts": "^0.5.0-alpha.4",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "jest": "^30.0.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "vsce": "^2.15.0"
  }
}
