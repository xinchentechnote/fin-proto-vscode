{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"isolatedModules": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": [
			"node",
			"jest"
		],
		"strict": true, /* enable all strict type-checking options */
		/* Additional Checks */
		// "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
		// "noFallthroughCasesInSwitch": true, /* Report errors on fallthrough cases in switch statement. */
		// "noUnusedParameters": true,  /* Report errors on unused parameters. */
	},
	"exclude": [
		"out",
		"dist",
		"src/test"
	]
}
